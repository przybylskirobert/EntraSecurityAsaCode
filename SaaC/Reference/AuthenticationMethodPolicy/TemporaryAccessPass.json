{
  "uri": "https://graph.microsoft.com/beta/authenticationMethodsPolicy",
  "url": "https://entra.microsoft.com/#view/Microsoft_AAD_IAM/AuthenticationMethodsMenuBlade/~/AdminAuthMethods/fromNav/Identity",
  "name": "Policy Authorization Policy",
  "config": {
    "displayName": "Authentication Methods Policy",
    "authenticationMethodConfigurations": [
      {
        "state": "enabled",
        "defaultLength": 12,
        "includeTargets@odata.context": "https://graph.microsoft.com/beta/$metadata#authenticationMethodsPolicy/authenticationMethodConfigurations('TemporaryAccessPass')/microsoft.graph.temporaryAccessPassAuthenticationMethodConfiguration/includeTargets",
        "id": "TemporaryAccessPass",
        "@odata.type": "#microsoft.graph.temporaryAccessPassAuthenticationMethodConfiguration",
        "defaultLifetimeInMinutes": 60,
        "maximumLifetimeInMinutes": 480,
        "isUsableOnce": true,
        "includeTargets": [
          {
            "isRegistrationRequired": false,
            "targetType": "group",
            "id": "all_users"
          }
        ],
        "minimumLifetimeInMinutes": 60,
        "excludeTargets": []
      }
    ]
  }
}